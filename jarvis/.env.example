# Copy to .env and fill in. .env is gitignored and should be chmod 600.
#   cp .env.example .env && chmod 600 .env

# --- the brain -----------------------------------------------------
# Without this JARVIS still runs: it routes by keyword and file score,
# and shows a badge saying the model is missing. It never pretends
# keyword matching is the model talking.
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5
# low | medium | high | xhigh | max — low keeps spoken replies fast
JARVIS_EFFORT=low

# --- voice ---------------------------------------------------------
# openai | elevenlabs | local | none
JARVIS_VOICE=openai
OPENAI_API_KEY=
JARVIS_TTS_VOICE=onyx
JARVIS_TTS_MODEL=tts-1
# JARVIS_STT_LANG=en

# Never spend without asking: voice stops at this much per run and says so.
JARVIS_VOICE_CAP_USD=0.50

# --- alternates ----------------------------------------------------
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# JARVIS_WHISPER_BIN=whisper-cli
# JARVIS_WHISPER_MODEL=/path/to/ggml-base.en.bin

# --- your data -----------------------------------------------------
# 1 = invented fixtures, safe to screen-record.  0 = your real folders.
JARVIS_DEMO=1
# Only read when JARVIS_DEMO=0. Colon-separated. Alternatively edit
# REAL_ROOTS in agent/data.py.
# JARVIS_ROOTS=/Users/you/Documents/Clients:/Users/you/Notes
# JARVIS_INBOX=/Users/you/exports/inbox.json
# JARVIS_CALENDAR=/Users/you/exports/calendar.json

JARVIS_PORT=8720
