# Copy to .env and fill in. .env is gitignored and should be chmod 600.
#   cp .env.example .env && chmod 600 .env

# --- the brain -----------------------------------------------------
# Without this JARVIS still runs: it routes by keyword and file score, and
# shows a badge saying the model is missing. It never passes keyword
# matching off as the model talking.
# Paying for Claude buys speed and judgement. Roughly, per turn, with the
# system prompt and tools cached (they are, automatically):
#   claude-opus-5     ~0.6c   sharpest
#   claude-sonnet-5   ~0.4c   very close, cheaper
#   claude-haiku-4-5  ~0.1c   fine for a command centre
# Commands still answer free and instantly via JARVIS_FAST, whatever is set
# here. The running total is shown on screen.
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5

# Google Gemini — fast, generous free tier, one key, no card required.
# Get it at aistudio.google.com/apikey.
#
# Key formats have changed over time: older ones begin "AIza", newer ones
# "AQ.". Both work. Nothing here checks the shape — whatever AI Studio shows
# you on the API key page is the key.
#
# The model is auto-selected from what your key can actually reach,
# preferring flash for latency; pin one with JARVIS_GEMINI_MODEL. Your
# prompts go to Google.
GEMINI_API_KEY=

# Which brain to use: auto | anthropic | gemini | ollama | none
# auto prefers Claude, then Gemini, then whatever is running locally.
JARVIS_LLM=auto
# low | medium | high | xhigh | max — low keeps spoken replies fast
JARVIS_EFFORT=low

# --- voice ---------------------------------------------------------
# auto (default) probes the machine and picks the best tier that actually
# works, then says which one is live on screen. Pin one by naming it:
#   openai | elevenlabs | local | none
JARVIS_VOICE=auto
OPENAI_API_KEY=
JARVIS_TTS_VOICE=onyx
JARVIS_TTS_MODEL=tts-1
# JARVIS_STT_LANG=en

# Listening and speaking are resolved SEPARATELY. Speech-OUT already works
# on every OS with nothing installed — macOS `say`, Windows SAPI, Linux
# espeak — so JARVIS talks to you even with no microphone tier at all.
#
# Speech-IN needs one of: an API key above, whisper.cpp, or (Windows only)
# the built-in recogniser, which needs nothing but is less accurate.
#   macOS:    brew install whisper-cpp
#   Windows:  download a whisper.cpp release, set JARVIS_WHISPER_BIN
# JARVIS_WHISPER_BIN=C:\tools\whisper\whisper-cli.exe
# JARVIS_WHISPER_MODEL=C:\tools\whisper\ggml-base.en.bin
# JARVIS_SAPI_VOICE=Microsoft David Desktop
# JARVIS_SAPI_RATE=1

# Never spend without asking: voice stops at this much per run and says so.
JARVIS_VOICE_CAP_USD=0.50

# Alternates
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- your data -----------------------------------------------------
# 1 = invented fixtures, safe to screen-record.  0 = your real folders.
JARVIS_DEMO=1
JARVIS_TZ=America/Chicago

# Only read when JARVIS_DEMO=0. Colon-separated absolute paths.
# Alternatively edit REAL_ROOTS in agent/data.py. Nothing is assumed.
# JARVIS_SCHOOL_ROOTS=/Users/you/Documents/School
# JARVIS_BUSINESS_ROOTS=/Users/you/Documents/Shopify
# JARVIS_DECA_ROOTS=/Users/you/Documents/DECA

# --- calendar feeds (the easy way in) ------------------------------
# Schoology, Canvas, PowerSchool and Google Calendar all publish a secret
# .ics link. One URL and JARVIS sees every due date — no OAuth, no consent
# screen, no Cloud Console. This is by far the least painful way to get
# school deadlines in, and it works for portals with no API client.
#
#   Schoology : Calendar > iCal Feed  (or Settings > iCal)
#   Canvas    : Calendar > Calendar Feed, bottom right
#   Google    : Settings > your calendar > Secret address in iCal format
#
# Comma-separate several. Treat these URLs as credentials: anyone holding
# one can read that calendar.
JARVIS_SCHOOL_ICS=
JARVIS_BUSINESS_ICS=
JARVIS_DECA_ICS=

# --- connectors (all read-only) ------------------------------------
# Anything left blank is reported as "not connected" on screen and in
# speech. JARVIS never guesses data for a service it cannot reach.

# Shopify: Admin API access token from a custom app.
# Scopes needed, read only: read_orders, read_products, read_customers.
# Do NOT grant any write_* scope — nothing here uses one.
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=

# Google — Gmail, Calendar, Classroom, Drive and YouTube, one login.
#
#   python3 agent/setup_google.py
#
# That walks the whole thing: opens the consent screen, catches the
# redirect, exchanges the code, and fills in the three values below. You do
# not need to edit them by hand.
#
# Every scope it asks for is READ-ONLY. There is no send scope and no write
# scope anywhere in this project.
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- control (Chrome and the machine) ------------------------------
# These are NOT read-only. JARVIS can navigate, click, fill, type, press
# keys and move the mouse. The kill switch is CTRL+ALT+Q anywhere, Esc in
# the page, or the Halt button. Every action is logged to
# memory/actions.log with where the instruction came from.
#
# Chrome ignores --remote-debugging-port on your DEFAULT profile (a Google
# security change), so JARVIS runs Chrome against its own profile folder.
# Log into your accounts once inside it and it persists.
JARVIS_CHROME_PORT=9222
# JARVIS_CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe
# JARVIS_CHROME_PROFILE=C:\Users\you\jarvis-chrome-profile

# Unambiguous commands — "brief me", "what's due", "how's the store" —
# answer straight from the tool in about a millisecond, skipping the model
# entirely. Real questions still go to the model. Set to 0 to always use it.
JARVIS_FAST=1

# --- local model speed --------------------------------------------
# The interface prints where each answer's time went — heard / read /
# thought / spoke. Tune against that rather than guessing.
#
# Biggest lever by far is the model itself. On a laptop:
#   ollama pull llama3.2:3b     fast, calls tools, good default
#   ollama pull qwen2.5:7b      slower, noticeably smarter
# JARVIS_OLLAMA_MODEL=llama3.2:3b

# Keeps the model in memory between turns. Without it every question pays
# the load cost again, which is usually most of the wait.
JARVIS_OLLAMA_KEEPALIVE=30m
# Spoken answers are short; a cap stops a local model rambling for a minute.
JARVIS_OLLAMA_PREDICT=220
JARVIS_OLLAMA_CTX=4096
# Local models get a compact system prompt. Set to 1 to send the full one.
# JARVIS_FULL_PROMPT=0

# --- noticing things ------------------------------------------------
# How often JARVIS looks around for anything worth mentioning unprompted:
# a deadline going overdue, one crossing inside two days, a new order, an
# order past the fulfilment window, stock running out, mail from a teacher
# or your DECA advisor.
#
# It reports only what CHANGED since the last look, so it cannot nag, and
# the first run of a fresh install records a baseline and says nothing.
# Set to 0 to switch it off entirely.
JARVIS_WATCH_MINUTES=10

JARVIS_PORT=8720
