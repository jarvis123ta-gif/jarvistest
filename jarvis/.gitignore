.env
__pycache__/
*.pyc
.DS_Store

# Your real life never gets committed.
data/inbox.live.json
data/calendar.live.json
data/*.live.json
memory/*.md
!memory/.gitkeep

# JARVIS's own Chrome profile — logged-in sessions, cookies, never committed.
chrome-profile/

# The action log is a record of what was done on this machine.
memory/actions.log

# The watcher's baseline: a snapshot of real deadlines, orders and mail.
# Runtime state, and private. Never commit it.
memory/watch.json
